# DeepSeek API Configuration
# Replace with your actual DeepSeek API Key (from https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Modèle utilisé pour TOUTE traduction PDF.
#
# ATTENTION : le moteur PDF v2 ne lit PAS le paramètre `quality` de la requête —
# `translate_pdf_progressive()` ne reçoit ni modèle ni budget de tokens, et
# `TranslatorAI` prend son modèle ICI. Cette variable est donc le SEUL réglage
# qui décide de la vitesse et du coût des traductions PDF. Y mettre un modèle de
# raisonnement ralentit et renchérit CHAQUE page, sans qu'aucune option de
# l'interface ne le laisse deviner.
#
#   deepseek-chat     = rapide et économique, non raisonnant  (défaut)
#   deepseek-v4-flash = raisonnement : alignement plus fiable sur les pages
#                       complexes, mais ~2 min/page et bien plus cher.
DEEPSEEK_MODEL=deepseek-chat

# Security Configuration
# Shared API key between frontend and backend. 
# Frontend sends this key in the header 'X-API-Key'
FRONTEND_API_KEY=precis_frontend_secure_key_2026_xK9mP2vL

# CORS Settings
# Comma-separated list of origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
