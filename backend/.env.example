# DeepSeek API Configuration
# Replace with your actual DeepSeek API Key (from https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Modèle utilisé pour TOUTE traduction PDF.
#
# ATTENTION : le moteur PDF v2 ne lit PAS le paramètre `quality` de la requête —
# `translate_pdf_progressive()` ne reçoit ni modèle ni budget de tokens, et
# `TranslatorAI` prend son modèle ICI. Cette variable est donc le SEUL réglage
# qui décide de la vitesse et du coût des traductions PDF. Y mettre un modèle de
# raisonnement ralentit et renchérit CHAQUE page, sans qu'aucune option de
# l'interface ne le laisse deviner.
#
#   deepseek-chat     = rapide et économique, non raisonnant  (défaut)
#   deepseek-v4-flash = raisonnement : alignement plus fiable sur les pages
#                       complexes, mais ~2 min/page et bien plus cher.
DEEPSEEK_MODEL=deepseek-chat

# Security Configuration
# Shared API key between frontend and backend. 
# Frontend sends this key in the header 'X-API-Key'
FRONTEND_API_KEY=precis_frontend_secure_key_2026_xK9mP2vL

# ── Base de données PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/precis

# ── Authentification ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-64-chars-minimum-long-random-string
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Email — Gmail SMTP (mot de passe d'application Google) ──────────────────
# 1. Activer la validation en 2 étapes sur votre compte Google
# 2. Aller sur https://myaccount.google.com/apppasswords
# 3. Générer un mot de passe d'application (type « Autre », nom « Precis »)
# 4. Copier les 16 caractères (sans espaces) ci-dessous dans SMTP_PASSWORD
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Précis <votre-email@gmail.com>

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# CORS Settings
# Comma-separated list of origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# ── Marque publique (filigrane de l'aperçu d'essai) ──────────────────────────
# Le filigrane de l'aperçu gratuit est une mini-publicité, cuite dans les pixels.
# Ces valeurs en composent le texte — au changement de domaine, rien à recompiler.
BRAND_NAME=PRÉCIS
BRAND_TAGLINE=Professional Translation
PUBLIC_SITE=precis-translator.com

# ── Ordonnanceur de traduction ───────────────────────────────────────────────
# Nombre de traductions menées EN PARALLÈLE. Au-delà, les demandes attendent
# dans une file de PRIORITÉ ordonnée par le plan (admin > pro > starter >
# gratuit) — c'est ce qui donne corps à la vitesse vendue sur la carte de tarifs.
# Le coût dominant étant le CPU de rendu, trop de workers sur une seule machine
# ralentit tout le monde. 2 = défaut prudent mono-serveur ; à monter avec les cœurs.
TRANSLATION_WORKERS=2
