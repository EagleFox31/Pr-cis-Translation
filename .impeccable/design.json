  "narrative": {
    "northStar": "Le papier de cabinet",
    "overview": "Précis se présente comme un document bien tenu : du papier blanc ou ivoire, une encre marine, un tampon bleu pour ce qu'on peut faire, un filet d'or pour ce qui mérite d'être remarqué. Les titres en Cormorant Garamond donnent la voix éditoriale ; tout ce qui se manipule (boutons, compteurs, listes, fenêtres) parle en DM Sans, net et compact. Le site promet de garder la mise en page ; son interface prouve le soin par l'ordre, pas par l'ornement.",
    "keyCharacteristics": [
      "Serif éditoriale pour les titres, sans-serif pour l'interface.",
      "Bleu d'encre unique pour l'action ; or réservé à l'accent rare.",
      "Surfaces blanches sur gray-50, filets gray-200, ombres teintées marine.",
      "Fenêtres compactes (400–440 px), voile marine flouté.",
      "Pastilles en pilule pour les statuts et les rubriques."
    ],
    "rules": [
      {
        "name": "The One Ink Rule",
        "body": "Une seule couleur d'action : le bleu tampon. Une deuxième couleur saturée sur un bouton ou un lien est une erreur.",
        "section": "colors"
      },
      {
        "name": "The Rare Gold Rule",
        "body": "L'or occupe moins de 2 % d'un écran. S'il apparaît sur une fenêtre ou un panneau, il est de trop.",
        "section": "colors"
      },
      {
        "name": "The Defined Gray Rule",
        "body": "Seuls gray-50, 100, 200, 300, 500, 700, 900 existent. gray-400 et gray-600 sont référencés dans le code sans être définis : ne pas s'en servir.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Cormorant pour ce qu'on lit, DM Sans pour ce qu'on manipule. Jamais de Cormorant dans un bouton, une pastille ou un compteur.",
        "section": "typography"
      },
      {
        "name": "The Flat-Until-Lifted Rule",
        "body": "Une carte posée sur la page n'a qu'un filet gray-200. L'ombre n'apparaît que pour ce qui flotte : barre fixée, tiroir, fenêtre.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do réutiliser les classes existantes (ui-btn, Badge, legal-page, ext-*, compte) avant d'en créer.",
      "Do écrire chaque chiffre affiché à partir d'une source du code ou du README.",
      "Do garder les cibles tactiles à 44 px au moins sur mobile.",
      "Do utiliser les icônes lucide en trait de 2, à 16–20 px."
    ],
    "donts": [
      "Don't utiliser de dégradés violets, de glassmorphism ni de mode sombre.",
      "Don't mettre de l'or sur un contrôle ou un fond.",
      "Don't reprendre « 100 % », « 50+ langues » ou « traducteurs humains certifiés » : ces affirmations ne sont pas sourcées.",
      "Don't présenter la traduction de scans comme ouverte au public tant que le README dit le contraire.",
      "Don't utiliser gray-400 ou gray-600."
    ]
  }
}