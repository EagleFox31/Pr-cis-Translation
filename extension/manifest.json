{
  "manifest_version": 3,
  "name": "__MSG_nom__",
  "default_locale": "fr",
  "version": "1.0.0",
  "description": "__MSG_description__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_titre_bouton__",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus"
  ],
  "commands": {
    "basculer": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Traduire la page ou rétablir l'original"
    }
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "https://precis-translator.trigenys.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*"
    ]
  }
}
