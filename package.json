{
  "name": "precis-translator",
  "version": "1.0.0",
  "description": "Precis Translator root project configuration",
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" --kill-others \"npm run --silent dev:backend\" \"npm run --silent dev:frontend\"",
    "dev:backend": "backend\\venv\\Scripts\\python scripts/run_uvicorn.py 8000",
    "dev:frontend": "echo   Front ~ http://localhost:3000 && npm --prefix frontend run --silent dev",
    "stop": "scripts\\stop.cmd"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
